entity User {
    nick?: String,
} tags {
    foo?: String,
    bar: Long,
    inner?: {
        s?: String,
    },
};

entity Document {
    owner: User,
};

action "view" appliesTo {
    principal: User,
    resource: Document,
    context: {
        key: String,
        other: String,
        flag: Bool,
        r: { a: Long, b: Long },
    },
};
